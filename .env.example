# Copy to .env and replace the placeholders with your Foundry project values.
FOUNDRY-PROJECT=https://<account>.services.ai.azure.com/api/projects/<project>
AGENT-NAMES=<agent-name>
MODEL-NAME=<judge-model-or-deployment>
EVAL-DATA-FILE=examples/multiturn-example.jsonl

# Optional settings:
# AGENT-VERSION=1
# EVAL-MODEL-DEPLOYMENT=<judge-deployment-name>
# SIMULATOR-MODEL-DEPLOYMENT=<simulator-deployment-name>
# CRITERIA-THRESHOLD=0.8
# PASS-RATE-GATE=0.8
